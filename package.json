{
  "name": "@dontblink-protocol/sdk",
  "version": "0.2.0",
  "description": "Launch tokens on dontblink (Robinhood Chain) from code — you keep your key, we just build the transaction right.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "keywords": [
    "dontblink",
    "robinhood-chain",
    "launchpad",
    "erc20",
    "uniswap-v3",
    "agent",
    "cli"
  ],
  "license": "BUSL-1.1",
  "peerDependencies": {
    "viem": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.0",
    "viem": "^2.0.0"
  },
  "bin": {
    "dontblink": "./dist/cli.js"
  },
  "private": true
}
